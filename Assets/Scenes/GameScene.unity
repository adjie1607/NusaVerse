--- !u!114 &737006701
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 737006699}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61e424a62639c784cb937149661e5a3e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  quizPanel: {fileID: 737006699}
  questionUI: {fileID: 1093966733}
  buttonTexts:
  - {fileID: 1512401045}
  - {fileID: 805073736}
  - {fileID: 2130281652}
  - {fileID: 859361936}
  soalRumah1:
  - questionText: "Pakaian adat khas suku Dayak \r\nyang terbuat dari serat alam
      dan \r\nmanik-manik bernama\u2026 "
    answerA: Ulos
    answerB: Ta'a & Sapei Sapaq
    answerC: Baju Bodo
    answerD: Nggembe
    correctAnswerIndex: 1
  - questionText: "Senjata tradisional yang menjadi \r\nikon suku Dayak adalah\u2026 "
    answerA: Keris
    answerB: Mandau
    answerC: Rencong
    answerD: Badik
    correctAnswerIndex: 1
  - questionText: "Alat musik tradisional Dayak \r\nyang paling ikonik untuk \r\nmengiringi
      upacara adat \r\nadalah\u2026 "
    answerA: Sape
    answerB: Angklung
    answerC: Kolintang
    answerD: Kecapi
    correctAnswerIndex: 0
  - questionText: "Permainan tradisional paling \r\nikonik masyarakat Dayak yang
      \r\nmenggunakan bilah bambu dan \r\nbola kecil disebut\u2026 "
    answerA: Engklek
    answerB: Lato-Lato
    answerC: Engrang
    answerD: Asinan
    correctAnswerIndex: 2
  - questionText: "Rumah Betang dibangun \r\nberbentuk panggung memanjang \r\ndengan
      tujuan\u2026"
    answerA: Upacara
    answerB: 'Menghindari Banjir dan Hewan Buas '
    answerC: Tempat Menyimpan Emas
    answerD: Arena Lomba
    correctAnswerIndex: 1
  soalRumah2:
  - questionText: "Pakaian adat tradisional \r\nSulawesi Tengah yang dipakai \r\nmasyarakat
      suku Kulawi \r\nbernama"
    answerA: a
    answerB: b
    answerC: c
    answerD: d
    correctAnswerIndex: 0
  - questionText: "Senjata tradisional khas \r\nSulawesi yang banyak \r\ndigunakan
      masyarakat di \r\nberbagai daerah disebut\u2026 "
    answerA: a
    answerB: b
    answerC: c
    answerD: d
    correctAnswerIndex: 1
  - questionText: "Permainan tradisional Sulawesi \r\nyang paling ikonik dan \r\nmenggunakan
      bola anyaman \r\nkaki adalah\u2026 "
    answerA: a
    answerB: b
    answerC: c
    answerD: d
    correctAnswerIndex: 0
  - questionText: "Instrumen gendang tradisional \r\npaling ikonik dari Sulawesi
      \r\nTengah disebut\u2026"
    answerA: a
    answerB: b
    answerC: c
    answerD: d
    correctAnswerIndex: 0
  - questionText: "Ciri khas utama Rumah Tambi \r\nadalah atap runcing yang \r\nterinspirasi
      dari\u2026 "
    answerA: a
    answerB: b
    answerC: c
    answerD: d
    correctAnswerIndex: 0
